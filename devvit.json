{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "modwingman",
  "server": {
    "entry": "index.js"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "generativelanguage.googleapis.com"
      ]
    },
    "reddit": {
      "enable": true,
      "scope": "moderator",
      "asUser": [
        "SUBMIT_COMMENT"
      ]
    },
    "redis": true
  },
  "triggers": {
    "onModMail": "/internal/triggers/modmail"
  },
  "settings": {
    "global": {
      "gemini_api_key": {
        "type": "string",
        "label": "Google AI Studio API key",
        "isSecret": true
      }
    }
  },
  "dev": {
    "subreddit": "modwingman_dev"
  }
}